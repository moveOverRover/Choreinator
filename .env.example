# Copy to .env.local for local development, or set these in your host (e.g. Vercel).

# --- Sign in with Google ---
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Long random string used to sign login cookies (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated Google emails that are always approved admins.
ADMIN_EMAILS=

# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON, keeping the \n sequences.
GOOGLE_PRIVATE_KEY=

# The app's own database spreadsheet (share it with the service account as Editor).
DB_SPREADSHEET_ID=

# The existing "Chore submission (Responses)" sheet (share with the service account as Viewer).
FORM_SPREADSHEET_ID=
FORM_RESPONSES_TAB=Form Responses 1

# Time zone used for "this week" on the chore board.
HOUSE_TIMEZONE=America/Vancouver

# --- Local development only ---
# DEV_LOGIN=1 shows a "type any email" sign-in box. Ignored in production builds.
# Leave DB_SPREADSHEET_ID empty locally to store data in .data/db.json instead of Sheets.
DEV_LOGIN=
